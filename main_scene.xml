<mujoco model="unitree_g1_apple_throwing_catching">
  <compiler angle="radian" meshdir="models/unitree_g1/assets"/>
  <include file="models/unitree_g1/g1_with_hands.xml"/>

  <visual>
    <headlight diffuse="0.75 0.75 0.75" ambient="0.25 0.25 0.25" specular="0.35 0.35 0.35"/>
    <rgba haze="0.12 0.18 0.25 1.0"/>
    <global azimuth="145" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.25 0.35 0.50" rgb2="0.08 0.10 0.15" width="512" height="3072"/>
    <texture type="2d" name="floor_tex" builtin="checker" rgb1="0.85 0.88 0.90" rgb2="0.75 0.78 0.82" width="500" height="500"/>
    <material name="floor_mat" texture="floor_tex" texuniform="true" texrepeat="10 10" reflectance="0.1"/>
    <material name="pedestal_mat" rgba="0.3 0.32 0.35 1" specular="0.4" shininess="0.3"/>
    <material name="apple_mat" rgba="0.88 0.12 0.12 1" specular="0.7" shininess="0.5"/>
  </asset>

  <worldbody>
    <light pos="1.5 0 3.5" dir="0 0 -1" directional="true" diffuse="0.85 0.85 0.85" specular="0.3 0.3 0.3"/>
    <light pos="-1.5 -1.0 2.5" dir="1 0.5 -1" directional="true" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="5 5 0.05" material="floor_mat" friction="1.5 0.05 0.01"/>

    <!-- Pedestal for physical apple pickup -->
    <body name="pedestal" pos="0.267 -0.162 0">
      <geom name="ped_base" type="cylinder" size="0.08 0.015" pos="0 0 0.015" material="pedestal_mat" contype="0" conaffinity="0"/>
      <geom name="ped_post" type="cylinder" size="0.018 0.36" pos="0 0 0.36" material="pedestal_mat" contype="0" conaffinity="0"/>
      <geom name="ped_cup" type="cylinder" size="0.025 0.01" pos="0 0 0.73" material="pedestal_mat"
            friction="0.8 0.005 0.0001" contype="2" conaffinity="0"/>
    </body>

    <!-- Physical Simulated Apple (ME 206 rigid-body parameters: m=0.150kg, r=0.038m) -->
    <body name="apple" pos="0.267 -0.162 0.778">
      <freejoint name="apple_joint"/>
      <inertial pos="0 0 0" mass="0.150" diaginertia="8.45e-5 8.45e-5 8.66e-5"/>
      <geom name="apple_geom" type="sphere" size="0.038"
            condim="6" friction="2.5 0.05 0.02" solref="0.004 1" solimp="0.95 0.99 0.001"
            contype="3" conaffinity="3" material="apple_mat"/>
      <geom name="apple_stem" type="cylinder" size="0.002 0.008" pos="0 0 0.040"
            rgba="0.35 0.20 0.08 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Subtle Ballistic Trajectory Indicator Sites -->
    <site name="traj_0" pos="0 0 -5" size="0.006" rgba="1.0 0.80 0.15 0.65" group="1"/>
    <site name="traj_1" pos="0 0 -5" size="0.006" rgba="1.0 0.80 0.15 0.65" group="1"/>
    <site name="traj_2" pos="0 0 -5" size="0.006" rgba="1.0 0.80 0.15 0.65" group="1"/>
    <site name="traj_3" pos="0 0 -5" size="0.006" rgba="1.0 0.80 0.15 0.65" group="1"/>
    <site name="traj_4" pos="0 0 -5" size="0.006" rgba="1.0 0.80 0.15 0.65" group="1"/>
    <site name="traj_5" pos="0 0 -5" size="0.006" rgba="1.0 0.80 0.15 0.65" group="1"/>
    <site name="traj_6" pos="0 0 -5" size="0.006" rgba="1.0 0.80 0.15 0.65" group="1"/>
    <site name="traj_7" pos="0 0 -5" size="0.006" rgba="1.0 0.80 0.15 0.65" group="1"/>

    <!-- Studio Cameras -->
    <camera name="front" pos="1.6 0 1.0" xyaxes="0 1 0 -0.2 0 0.98"/>
    <camera name="closeup" pos="0.85 0 0.88" xyaxes="0 1 0 -0.1 0 0.99"/>
    <camera name="side_trajectory" pos="0.35 1.5 0.95" xyaxes="-1 0 0 0 -0.2 0.98"/>
  </worldbody>
</mujoco>
